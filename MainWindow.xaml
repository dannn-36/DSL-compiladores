<Window x:Class="CreditDsl.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credit DSL | Evaluador de decisiones" Width="1360" Height="820" MinWidth="1080" MinHeight="700"
        Background="#F2F6F5" FontFamily="Segoe UI" Foreground="#132238">
    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="CREDIT DSL" Foreground="#0F766E" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="Evaluador de decisiones crediticias" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="Un pequeño lenguaje de reglas representado y evaluado mediante árboles de sintaxis abstracta." Foreground="#64748B" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#CCFBF1" CornerRadius="18" Padding="14,8">
                <TextBlock Text="AST + MOTOR DE REGLAS" Foreground="#115E59" FontSize="11" FontWeight="Bold" />
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Datos de la solicitud" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <TextBlock Text="Edad" Style="{StaticResource LabelStyle}" /><TextBox x:Name="AgeInput" Text="25" Style="{StaticResource InputStyle}" Margin="0,0,0,12" />
                        <TextBlock Text="Ingresos mensuales (COP)" Style="{StaticResource LabelStyle}" /><TextBox x:Name="IncomeInput" Text="5000000" Style="{StaticResource InputStyle}" Margin="0,0,0,12" />
                        <TextBlock Text="Puntaje crediticio" Style="{StaticResource LabelStyle}" /><TextBox x:Name="ScoreInput" Text="750" Style="{StaticResource InputStyle}" Margin="0,0,0,12" />
                        <TextBlock Text="Antigüedad laboral (meses)" Style="{StaticResource LabelStyle}" /><TextBox x:Name="SeniorityInput" Text="24" Style="{StaticResource InputStyle}" Margin="0,0,0,12" />
                        <TextBlock Text="¿Tiene mora actual? (si/no)" Style="{StaticResource LabelStyle}" /><TextBox x:Name="DelinquencyInput" Text="no" Style="{StaticResource InputStyle}" Margin="0,0,0,20" />
                        <Button Content="▶  Evaluar solicitud" Click="EvaluateButton_Click" Style="{StaticResource PrimaryButton}" Height="42" />
                        <Button Content="Restablecer valores" Click="ResetButton_Click" Background="Transparent" Foreground="#0F766E" BorderBrush="#99F6E4" BorderThickness="1" Padding="12,8" Margin="0,10,0,0" />
                        <TextBlock x:Name="ValidationText" Foreground="#B91C1C" TextWrapping="Wrap" FontSize="12" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Resultados" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryText" Text="Listos para evaluar" Foreground="#64748B" Margin="14,4,0,0" />
                    </StackPanel>
                    <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Code}" Width="55" />
                            <DataGridTextColumn Header="Regla" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="110" />
                            <DataGridTextColumn Header="Asignación" Binding="{Binding Assignment}" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Árbol de sintaxis abstracta" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Seleccione una regla para inspeccionar su representación." Foreground="#64748B" FontSize="12" Margin="0,4,0,15" TextWrapping="Wrap" />
                        <ComboBox x:Name="RuleSelector" DisplayMemberPath="Code" SelectionChanged="RuleSelector_SelectionChanged" Height="34" Padding="8,5" Margin="0,0,0,12" />
                    </StackPanel>
                    <TreeView x:Name="AstTree" Grid.Row="1" BorderThickness="0" Background="Transparent" />
                    <Border Grid.Row="2" Background="#F0FDFA" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <TextBlock Text="La regla se construye como nodos y se recorre contra el contexto ingresado." TextWrapping="Wrap" Foreground="#115E59" FontSize="12" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
